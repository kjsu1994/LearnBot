        "fetchedPages": [
          { "url": "https://example.com/docs", "depth": 0, "storedAsSeparateDocument": true, "sourceUri": "https://example.com/docs" },
          { "url": "https://example.com/docs/setup", "depth": 1, "storedAsSeparateDocument": true, "sourceUri": "https://example.com/docs/setup" }
        ],
        "skippedPages": [
          {
            "url": "https://evil.example.net/docs",
            "reason": "DOMAIN_NOT_ALLOWED",
            "category": "POLICY_BLOCK",
            "severity": "WARNING",
            "indexingBlocked": true,
            "userAction": "Add the domain to the crawler allowlist or choose an allowed URL."
          }
        ]
