<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LearnBotAgentHost</AssemblyName>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Platforms>x64</Platforms>
    <LearnBotPublicBaseUrl Condition="'$(LearnBotPublicBaseUrl)' == ''">https://learnbot.example.invalid</LearnBotPublicBaseUrl>
    <LearnBotAllowInsecurePrivateNetwork Condition="'$(LearnBotAllowInsecurePrivateNetwork)' == ''">false</LearnBotAllowInsecurePrivateNetwork>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LearnBotPublicBaseUrl" Value="$(LearnBotPublicBaseUrl)" />
    <AssemblyMetadata Include="LearnBotAllowInsecurePrivateNetwork" Value="$(LearnBotAllowInsecurePrivateNetwork)" />
    <Compile Include="..\Security\ServerOriginPolicy.cs" Link="Security\ServerOriginPolicy.cs" />
  </ItemGroup>
</Project>
